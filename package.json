{
	"name": "timeline",
	"description": "A keyframe timeline editor for tween.js: layers, a curve tool for custom easings, and a two-way timeline <-> code compiler.",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "Davlatjon Shavkatov <opensource@dalisoft.uz>",
	"homepage": "https://tweenjs.github.io/timeline/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tweenjs/timeline.git"
	},
	"bugs": {
		"url": "https://github.com/tweenjs/timeline/issues"
	},
	"keywords": [
		"tween.js",
		"animation",
		"timeline",
		"keyframes",
		"easing",
		"editor"
	],
	"scripts": {
		"sync-helper": "node scripts/radix-scales.mjs && node scripts/docs-vendor.mjs",
		"dev": "bun run sync-helper && vite",
		"build": "bun run sync-helper && tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "bun run test-model && bun run build && bun run test-e2e",
		"test-model": "node --test test/model.test.mjs",
		"test-e2e-dev": "E2E_MODE=dev playwright test",
		"test-e2e": "playwright test",
		"lint": "prettier . --check",
		"format": "prettier . --write",
		"docs:shots": "playwright test -c scripts/docs-shots/playwright.config.ts"
	},
	"dependencies": {
		"@lezer/highlight": "^1.2.5",
		"@lezer/javascript": "^1.5.7",
		"@solidjs/web": "^2.0.4",
		"@tweenjs/tween.js": "github:tweenjs/tween.js#09f2a635d7021d4f0c6be50a182ebc5be79ee2ba",
		"solid-js": "^2.0.4",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@radix-ui/colors": "3.0.0",
		"@solidjs/vite-plugin": "^3.0.1",
		"@types/node": "^26.6.10",
		"@types/three": "^0.187.0",
		"docsify": "^5.1.0",
		"es6-tween": "^5.5.11",
		"prettier": "^3.10.1",
		"typescript": "^5.9.0",
		"vite": "^8.3.8"
	}
}
